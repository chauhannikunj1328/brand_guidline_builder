      "in": {
        "$type": "cubicBezier",
        "$value": [
          0.7,
          0,
          0.84,
          0
        ]
      },
      "in-out": {
        "$type": "cubicBezier",
        "$value": [
          0.65,
          0,
          0.35,
          1
        ]
      }
    }
