{
  "$schema": "https://tr.designtokens.org/format/",
  "version": "1.0.0",
  "brand": "Rectio",
  "color": {
    "indigo":   { "$type": "color", "$value": "#4338CA", "$description": "Rectio Indigo — primary" },
    "coral":    { "$type": "color", "$value": "#FF6B4A", "$description": "Signal Coral — accent / mark" },
    "midnight": { "$type": "color", "$value": "#111C44" },
    "cloud":    { "$type": "color", "$value": "#DFE4FF" },
    "sky":      { "$type": "color", "$value": "#8FA3FF" },
    "white":    { "$type": "color", "$value": "#FFFFFF" },
    "fog":      { "$type": "color", "$value": "#F6F7FB" },
    "slate":    { "$type": "color", "$value": "#6B7394" },
    "success":  { "$type": "color", "$value": "#15803D" },
    "warning":  { "$type": "color", "$value": "#B45309" },
    "danger":   { "$type": "color", "$value": "#DC2626" }
  },
  "semantic": {
    "light": {
      "bg":     { "page": { "$type": "color", "$value": "{color.fog}" },
                  "surface": { "$type": "color", "$value": "{color.white}" },
                  "surface-tint": { "$type": "color", "$value": "{color.cloud}" },
                  "brand": { "$type": "color", "$value": "{color.indigo}" },
                  "inverse": { "$type": "color", "$value": "{color.midnight}" } },
      "text":   { "primary": { "$type": "color", "$value": "{color.midnight}" },
                  "secondary": { "$type": "color", "$value": "{color.slate}" },
                  "on-brand": { "$type": "color", "$value": "{color.white}" },
                  "link": { "$type": "color", "$value": "{color.indigo}" } },
      "border": { "default": { "$type": "color", "$value": "{color.cloud}" } },
      "action": { "primary": { "$type": "color", "$value": "{color.indigo}" },
                  "primary-hover": { "$type": "color", "$value": "#3730A3" },
                  "accent": { "$type": "color", "$value": "{color.coral}" } },
      "focus":  { "ring": { "$type": "color", "$value": "{color.coral}" } }
    },
    "dark": {
      "bg":     { "page": { "$type": "color", "$value": "{color.midnight}" },
                  "surface": { "$type": "color", "$value": "#1A2657" },
                  "surface-tint": { "$type": "color", "$value": "#26346B" },
                  "brand": { "$type": "color", "$value": "{color.indigo}" },
                  "inverse": { "$type": "color", "$value": "{color.white}" } },
      "text":   { "primary": { "$type": "color", "$value": "{color.white}" },
                  "secondary": { "$type": "color", "$value": "#A9B3D6" },
                  "on-brand": { "$type": "color", "$value": "{color.white}" },
                  "link": { "$type": "color", "$value": "{color.sky}" } },
      "border": { "default": { "$type": "color", "$value": "#33417A" } },
      "action": { "primary": { "$type": "color", "$value": "{color.indigo}" },
                  "primary-hover": { "$type": "color", "$value": "#4F46E5" },
                  "accent": { "$type": "color", "$value": "{color.coral}" } },
      "focus":  { "ring": { "$type": "color", "$value": "{color.coral}" } }
    }
  },
  "font": {
    "family": {
      "display": { "$type": "fontFamily", "$value": ["Plus Jakarta Sans", "system-ui", "sans-serif"] },
      "body":    { "$type": "fontFamily", "$value": ["Inter", "system-ui", "sans-serif"] },
      "mono":    { "$type": "fontFamily", "$value": ["JetBrains Mono", "ui-monospace", "monospace"] }
    },
    "size": {
      "display-xl": { "$type": "dimension", "$value": "96px" },
      "display-lg": { "$type": "dimension", "$value": "64px" },
      "heading-1":  { "$type": "dimension", "$value": "40px" },
      "heading-2":  { "$type": "dimension", "$value": "32px" },
      "heading-3":  { "$type": "dimension", "$value": "24px" },
      "heading-4":  { "$type": "dimension", "$value": "20px" },
      "body-lg":    { "$type": "dimension", "$value": "18px" },
      "body":       { "$type": "dimension", "$value": "16px" },
      "body-sm":    { "$type": "dimension", "$value": "14px" },
      "label":      { "$type": "dimension", "$value": "14px" },
      "caption":    { "$type": "dimension", "$value": "12px" },
      "overline":   { "$type": "dimension", "$value": "12px" }
    },
    "weight": {
      "light": { "$type": "fontWeight", "$value": 300 },
      "regular": { "$type": "fontWeight", "$value": 400 },
      "medium": { "$type": "fontWeight", "$value": 500 },
      "semibold": { "$type": "fontWeight", "$value": 600 },
      "bold": { "$type": "fontWeight", "$value": 700 },
      "extrabold": { "$type": "fontWeight", "$value": 800 }
    },
    "lineHeight": {
      "tight": { "$type": "number", "$value": 1.0 },
      "heading": { "$type": "number", "$value": 1.15 },
      "body": { "$type": "number", "$value": 1.5 },
      "relaxed": { "$type": "number", "$value": 1.6 }
    }
  },
  "space": {
    "1": { "$type": "dimension", "$value": "4px" },
    "2": { "$type": "dimension", "$value": "8px" },
    "3": { "$type": "dimension", "$value": "12px" },
    "4": { "$type": "dimension", "$value": "16px" },
    "5": { "$type": "dimension", "$value": "20px" },
    "6": { "$type": "dimension", "$value": "24px" },
    "8": { "$type": "dimension", "$value": "32px" },
    "10": { "$type": "dimension", "$value": "40px" },
    "12": { "$type": "dimension", "$value": "48px" },
    "16": { "$type": "dimension", "$value": "64px" },
    "24": { "$type": "dimension", "$value": "96px" },
    "32": { "$type": "dimension", "$value": "128px" }
  },
  "radius": {
    "sm": { "$type": "dimension", "$value": "8px" },
    "md": { "$type": "dimension", "$value": "12px" },
    "lg": { "$type": "dimension", "$value": "24px" },
    "xl": { "$type": "dimension", "$value": "32px" },
    "pill": { "$type": "dimension", "$value": "999px" }
  },
  "breakpoint": {
    "sm": { "$type": "dimension", "$value": "640px" },
    "md": { "$type": "dimension", "$value": "768px" },
    "lg": { "$type": "dimension", "$value": "1024px" },
    "xl": { "$type": "dimension", "$value": "1280px" },
    "2xl": { "$type": "dimension", "$value": "1536px" }
  },
  "motion": {
    "duration": {
      "instant": { "$type": "duration", "$value": "100ms" },
      "fast": { "$type": "duration", "$value": "200ms" },
      "base": { "$type": "duration", "$value": "300ms" },
      "slow": { "$type": "duration", "$value": "500ms" }
    },
    "easing": {
      "out": { "$type": "cubicBezier", "$value": [0.16, 1, 0.3, 1] },
      "in": { "$type": "cubicBezier", "$value": [0.7, 0, 0.84, 0] },
      "in-out": { "$type": "cubicBezier", "$value": [0.65, 0, 0.35, 1] }
    }
  },
  "shadow": {
    "1": { "$type": "shadow", "$value": { "color": "#111C441F", "offsetX": "0px", "offsetY": "8px", "blur": "24px", "spread": "0px" } },
    "2": { "$type": "shadow", "$value": { "color": "#111C4433", "offsetX": "0px", "offsetY": "24px", "blur": "64px", "spread": "0px" } }
  }
}
