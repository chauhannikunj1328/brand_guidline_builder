{
  "$schema": "https://tr.designtokens.org/format/",
  "version": "{{VERSION}}",
  "brand": "{{BRAND_NAME}}",
  "color": {
    "primary": { "$type": "color", "$value": "{{PRIMARY_HEX}}", "$description": "{{PRIMARY_NAME}}" },
    "accent":  { "$type": "color", "$value": "{{ACCENT_HEX}}",  "$description": "{{ACCENT_NAME}}" },
    "ink":     { "$type": "color", "$value": "{{INK_HEX}}",     "$description": "{{INK_NAME}}" },
    "tint":    { "$type": "color", "$value": "{{TINT_HEX}}",    "$description": "{{TINT_NAME}}" },
    "mid":     { "$type": "color", "$value": "{{MID_HEX}}",     "$description": "{{MID_NAME}}" },
    "white":   { "$type": "color", "$value": "#FFFFFF" },
    "bg":      { "$type": "color", "$value": "{{BG_HEX}}",      "$description": "{{BG_NAME}}" },
    "muted":   { "$type": "color", "$value": "{{MUTED_HEX}}",   "$description": "{{MUTED_NAME}}" },
    "success": { "$type": "color", "$value": "{{SUCCESS_HEX}}" },
    "warning": { "$type": "color", "$value": "{{WARNING_HEX}}" },
    "danger":  { "$type": "color", "$value": "{{DANGER_HEX}}" }
  },
  "semantic": {
    "light": {
      "bg":     { "page": { "$type": "color", "$value": "{color.bg}" },
                  "surface": { "$type": "color", "$value": "{color.white}" },
                  "surface-tint": { "$type": "color", "$value": "{color.tint}" },
                  "brand": { "$type": "color", "$value": "{color.primary}" },
                  "inverse": { "$type": "color", "$value": "{color.ink}" } },
      "text":   { "primary": { "$type": "color", "$value": "{color.ink}" },
                  "secondary": { "$type": "color", "$value": "{color.muted}" },
                  "on-brand": { "$type": "color", "$value": "{color.white}" },
                  "link": { "$type": "color", "$value": "{color.primary}" } },
      "border": { "default": { "$type": "color", "$value": "{color.tint}" } },
      "action": { "primary": { "$type": "color", "$value": "{color.primary}" },
                  "primary-hover": { "$type": "color", "$value": "{{PRIMARY_HOVER_HEX}}" },
                  "accent": { "$type": "color", "$value": "{color.accent}" } },
      "focus":  { "ring": { "$type": "color", "$value": "{color.accent}" } }
    },
    "dark": {
      "bg":     { "page": { "$type": "color", "$value": "{color.ink}" },
                  "surface": { "$type": "color", "$value": "{{DARK_SURFACE_HEX}}" },
                  "surface-tint": { "$type": "color", "$value": "{{DARK_SURFACE_TINT_HEX}}" },
                  "brand": { "$type": "color", "$value": "{color.primary}" },
                  "inverse": { "$type": "color", "$value": "{color.white}" } },
      "text":   { "primary": { "$type": "color", "$value": "{color.white}" },
                  "secondary": { "$type": "color", "$value": "{{DARK_TEXT_SECONDARY_HEX}}" },
                  "on-brand": { "$type": "color", "$value": "{color.white}" },
                  "link": { "$type": "color", "$value": "{color.mid}" } },
      "border": { "default": { "$type": "color", "$value": "{{DARK_BORDER_HEX}}" } },
      "action": { "primary": { "$type": "color", "$value": "{color.primary}" },
                  "primary-hover": { "$type": "color", "$value": "{{PRIMARY_HOVER_DARK_HEX}}" },
                  "accent": { "$type": "color", "$value": "{color.accent}" } },
      "focus":  { "ring": { "$type": "color", "$value": "{color.accent}" } }
    }
  },
  "font": {
    "family": {
      "display": { "$type": "fontFamily", "$value": ["{{DISPLAY_FONT}}", "system-ui", "sans-serif"] },
      "body":    { "$type": "fontFamily", "$value": ["{{BODY_FONT}}", "system-ui", "sans-serif"] },
      "mono":    { "$type": "fontFamily", "$value": ["{{MONO_FONT}}", "ui-monospace", "monospace"] }
    },
    "size": {
      "display-xl": { "$type": "dimension", "$value": "96px" },
      "display-lg": { "$type": "dimension", "$value": "64px" },
      "heading-1":  { "$type": "dimension", "$value": "40px" },
      "heading-2":  { "$type": "dimension", "$value": "32px" },
      "heading-3":  { "$type": "dimension", "$value": "24px" },
      "heading-4":  { "$type": "dimension", "$value": "20px" },
      "body-lg":    { "$type": "dimension", "$value": "18px" },
      "body":       { "$type": "dimension", "$value": "{{BASE_SIZE}}px" },
      "body-sm":    { "$type": "dimension", "$value": "14px" },
      "label":      { "$type": "dimension", "$value": "14px" },
      "caption":    { "$type": "dimension", "$value": "12px" },
      "overline":   { "$type": "dimension", "$value": "12px" }
    },
    "weight": {
      "display": { "$type": "fontWeight", "$value": "{{DISPLAY_WEIGHT}}" },
      "heading": { "$type": "fontWeight", "$value": "{{HEADING_WEIGHT}}" },
      "regular": { "$type": "fontWeight", "$value": 400 },
      "medium":  { "$type": "fontWeight", "$value": 500 },
      "semibold": { "$type": "fontWeight", "$value": 600 }
    },
    "lineHeight": {
      "tight": { "$type": "number", "$value": 1.0 },
      "heading": { "$type": "number", "$value": 1.15 },
      "body": { "$type": "number", "$value": 1.5 },
      "relaxed": { "$type": "number", "$value": 1.6 }
    }
  },
  "space": {
    "1": { "$type": "dimension", "$value": "4px" },
    "2": { "$type": "dimension", "$value": "8px" },
    "3": { "$type": "dimension", "$value": "12px" },
    "4": { "$type": "dimension", "$value": "16px" },
    "5": { "$type": "dimension", "$value": "20px" },
    "6": { "$type": "dimension", "$value": "24px" },
    "8": { "$type": "dimension", "$value": "32px" },
    "10": { "$type": "dimension", "$value": "40px" },
    "12": { "$type": "dimension", "$value": "48px" },
    "16": { "$type": "dimension", "$value": "64px" },
    "24": { "$type": "dimension", "$value": "96px" },
    "32": { "$type": "dimension", "$value": "128px" }
  },
  "radius": {
    "sm":   { "$type": "dimension", "$value": "{{RADIUS_SM}}px" },
    "md":   { "$type": "dimension", "$value": "{{RADIUS_MD}}px" },
    "lg":   { "$type": "dimension", "$value": "{{RADIUS_LG}}px" },
    "xl":   { "$type": "dimension", "$value": "{{RADIUS_XL}}px" },
    "pill": { "$type": "dimension", "$value": "999px" }
  },
  "breakpoint": {
    "sm": { "$type": "dimension", "$value": "640px" },
    "md": { "$type": "dimension", "$value": "768px" },
    "lg": { "$type": "dimension", "$value": "1024px" },
    "xl": { "$type": "dimension", "$value": "1280px" },
    "2xl": { "$type": "dimension", "$value": "1536px" }
  },
  "motion": {
    "duration": {
      "instant": { "$type": "duration", "$value": "{{DUR_INSTANT}}ms" },
      "fast":    { "$type": "duration", "$value": "{{DUR_FAST}}ms" },
      "base":    { "$type": "duration", "$value": "{{DUR_BASE}}ms" },
      "slow":    { "$type": "duration", "$value": "{{DUR_SLOW}}ms" }
    },
    "easing": {
      "out":    { "$type": "cubicBezier", "$value": [0.16, 1, 0.3, 1] },
      "in":     { "$type": "cubicBezier", "$value": [0.7, 0, 0.84, 0] },
      "in-out": { "$type": "cubicBezier", "$value": [0.65, 0, 0.35, 1] }
    }
  },
  "shadow": {
    "1": { "$type": "shadow", "$value": { "color": "{{INK_HEX}}1F", "offsetX": "0px", "offsetY": "8px",  "blur": "24px", "spread": "0px" } },
    "2": { "$type": "shadow", "$value": { "color": "{{INK_HEX}}33", "offsetX": "0px", "offsetY": "24px", "blur": "64px", "spread": "0px" } }
  }
}
